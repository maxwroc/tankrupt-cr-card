{
  "name": "tankrupt-cr-card",
  "version": "0.0.0",
  "description": "Home Assistant fuel and EV spending card powered by Custom Records",
  "type": "module",
  "module": "dist/tankrupt-cr-card.js",
  "author": "Max Chodorowski",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/maxwroc/tankrupt-cr-card.git"
  },
  "keywords": [
    "home-assistant",
    "lovelace",
    "custom-cards",
    "custom-records",
    "fuel",
    "electric-vehicle"
  ],
  "scripts": {
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\" \"demo/**/*.ts\"",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "build": "rollup -c",
    "watch": "rollup -c --watch",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\""
  },
  "dependencies": {
    "@js-temporal/polyfill": "^0.5.1",
    "custom-card-helpers": "^2.0.0",
    "decimal.js-light": "^2.5.1",
    "lit": "^3.3.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@rollup/plugin-commonjs": "^28.0.0",
    "@rollup/plugin-node-resolve": "^16.0.0",
    "@rollup/plugin-terser": "^1.0.0",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.0.0",
    "happy-dom": "^20.0.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.3.0",
    "rollup": "^4.20.0",
    "rollup-plugin-esbuild": "^6.2.1",
    "rollup-plugin-serve": "^3.0.0",
    "tslib": "^2.6.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.2.4",
    "yaml": "^2.8.1"
  }
}
